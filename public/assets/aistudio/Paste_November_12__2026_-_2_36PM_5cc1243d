        class HerbalQuizApp {
            constructor() {
                this.sound = new SoundFX();
                this.mode = 'solo'; // 'solo' or 'multi'
                this.nickname = 'หมอสมุนไพร';
                this.roomCode = '';
                this.isHost = false;
                this.currentQuestionIndex = 0;
                this.score = 0;
                this.correctCount = 0;
                this.combo = 0;
                this.maxCombo = 0;
                this.timer = 15;
                this.timerInterval = null;
                this.answeredQuestionsLog = [];
                this.players = [];
                this.isMultiplayerActive = false;
            }

            toggleSound() {
                this.sound.enabled = !this.sound.enabled;
                const btn = document.getElementById('sound-toggle');
                btn.innerHTML = this.sound.enabled ? '<i class="fa-solid fa-volume-high text-lg"></i>' : '<i class="fa-solid fa-volume-xmark text-lg text-slate-400"></i>';
                this.sound.playClick();
            }

            switchView(viewId) {
                ['view-home', 'view-game', 'view-result'].forEach(id => {
                    document.getElementById(id).classList.add('hidden');
                });
                document.getElementById(viewId).classList.remove('hidden');
            }

            openModal(modalId) {
                document.getElementById(modalId).classList.remove('hidden');
                this.sound.playClick();
            }

            closeModal(modalId) {
                document.getElementById(modalId).classList.add('hidden');
                this.sound.playClick();
            }

            returnToHome() {
                this.stopTimer();
                this.isMultiplayerActive = false;
                this.switchView('view-home');
                this.sound.playClick();
            }

            startSoloMode() {
                this.sound.playClick();
                const nickInput = document.getElementById('player-nickname').value.trim();
                if (nickInput) this.nickname = nickInput;
                
                this.mode = 'solo';
                this.currentQuestionIndex = 0;
                this.score = 0;
                this.correctCount = 0;
                this.combo = 0;
                this.maxCombo = 0;
                this.answeredQuestionsLog = [];

                document.getElementById('game-mode-badge').textContent = 'Solo Practice';
                document.getElementById('room-code-display').textContent = `ผู้เล่น: ${this.nickname}`;
                document.getElementById('multiplayer-scoreboard-box').classList.add('hidden');

                this.switchView('view-game');
                this.loadQuestion();
            }

            showMultiplayerModal() {
                const nickInput = document.getElementById('player-nickname').value.trim();
                if (nickInput) this.nickname = nickInput;
                this.openModal('modal-multiplayer');
            }

            createRoom() {
                this.sound.playClick();
                this.roomCode = Math.floor(1000 + Math.random() * 9000).toString();
                this.isHost = true;
                this.mode = 'multi';
                this.players = [{ name: this.nickname, score: 0, isHost: true }];
                
                this.closeModal('modal-multiplayer');
                this.openLobby();
            }

            joinRoom() {
                this.sound.playClick();
                const code = document.getElementById('room-code-input').value.trim().toUpperCase();
                if (!code || code.length < 4) {
                    alert('กรุณากรอกรหัสห้อง 4 หลักให้ถูกต้อง');
                    return;
                }
                this.roomCode = code;
                this.isHost = false;
                this.mode = 'multi';
                this.players = [
                    { name: 'หัวหน้าห้อง (Host)', score: 0, isHost: true },
                    { name: this.nickname, score: 0, isHost: false }
                ];

                this.closeModal('modal-multiplayer');
                this.openLobby();
            }

            openLobby() {
                document.getElementById('lobby-room-code-badge').textContent = this.roomCode;
                document.getElementById('lobby-player-count').textContent = this.players.length;
                
                const box = document.getElementById('lobby-players-box');
                box.innerHTML = this.players.map(p => `
                    <div class="flex items-center justify-between text-xs py-1.5 px-3 rounded-lg bg-slate-50 border border-slate-100">
                        <span class="font-medium text-slate-800"><i class="fa-solid fa-user-circle text-clinical-600 mr-2"></i>${p.name}</span>
                        ${p.isHost ? '<span class="px-2 py-0.5 rounded bg-amber-100 text-amber-700 font-bold text-[10px]">Host</span>' : '<span class="text-slate-400">พร้อม</span>'}
                    </div>
                `).join('');

                if (this.isHost) {
                    document.getElementById('host-controls').classList.remove('hidden');
                    document.getElementById('guest-waiting-text').classList.add('hidden');
                } else {
                    document.getElementById('host-controls').classList.add('hidden');
                    document.getElementById('guest-waiting-text').classList.remove('hidden');
                    
                    // Simulate guest auto-start when host starts
                    setTimeout(() => {
                        if (document.getElementById('modal-lobby').classList.contains('hidden') === false && !this.isMultiplayerActive) {
                            // auto sync simulation
                        }
                    }, 2000);
                }

                this.openModal('modal-lobby');
            }

            startMultiplayerGame() {
                this.sound.playClick();
                this.closeModal('modal-lobby');
                this.isMultiplayerActive = true;
                this.currentQuestionIndex = 0;
                this.score = 0;
                this.correctCount = 0;
                this.combo = 0;
                this.maxCombo = 0;
                this.answeredQuestionsLog = [];

                document.getElementById('game-mode-badge').textContent = `Multiplayer Room: ${this.roomCode}`;
                document.getElementById('room-code-display').textContent = `ผู้เล่น: ${this.nickname}`;
                document.getElementById('multiplayer-scoreboard-box').classList.remove('hidden');

                this.updateLiveScoreboard();
                this.switchView('view-game');
                this.loadQuestion();
            }

            updateLiveScoreboard() {
                const box = document.getElementById('live-players-list');
                // Simulate slight score fluctuations for simulated opponents in room
                if (this.mode === 'multi' && Math.random() > 0.6) {
                    this.players.forEach(p => {
                        if (p.name !== this.nickname && Math.random() > 0.5) {
                            p.score += Math.floor(Math.random() * 150);
                        }
                    });
                }
                // Sort by score descending
                const sorted = [...this.players].sort((a,b) => b.score - a.score);
                box.innerHTML = sorted.map((p, idx) => `
                    <div class="flex items-center justify-between text-xs py-1 px-2 rounded bg-slate-50">
                        <span class="font-medium text-slate-700">${idx+1}. ${p.name} ${p.name === this.nickname ? '(คุณ)' : ''}</span>
                        <span class="font-bold text-clinical-600">${p.score} pts</span>
                    </div>
                `).join('');
            }

            loadQuestion() {
                if (this.currentQuestionIndex >= questionBank.length) {
                    this.endGame();
                    return;
                }

                const q = questionBank[this.currentQuestionIndex];
                document.getElementById('question-progress').textContent = `คำถามข้อที่ ${this.currentQuestionIndex + 1} จาก ${questionBank.length}`;
                document.getElementById('question-text').textContent = q.question;
                
                // Shuffle options
                const shuffledOptions = [...q.options].sort(() => Math.random() - 0.5);
                const container = document.getElementById('options-container');
                container.innerHTML = '';

                shuffledOptions.forEach(opt => {
                    const btn = document.createElement('button');
                    btn.className = 'w-full text-left p-4 rounded-2xl bg-white border border-slate-200 hover:border-clinical-500 hover:bg-clinical-50/50 transition-all text-slate-700 font-medium text-sm flex items-center justify-between group shadow-sm';
                    btn.innerHTML = `
                        <span>${opt}</span>
                        <i class="fa-solid fa-chevron-right text-xs text-slate-300 group-hover:text-clinical-600"></i>
                    `;
                    btn.onclick = () => this.handleAnswer(opt, q.correct, btn);
                    container.appendChild(btn);
                });

                this.startTimer();
            }

            startTimer() {
                this.stopTimer();
                this.timer = 15;
                document.getElementById('timer-display').textContent = this.timer;

                this.timerInterval = setInterval(() => {
                    this.timer--;
                    document.getElementById('timer-display').textContent = this.timer;
                    if (this.timer <= 0) {
                        this.stopTimer();
                        this.handleTimeOut();
                    }
                }, 1000);
            }

            stopTimer() {
                if (this.timerInterval) {
                    clearInterval(this.timerInterval);
                    this.timerInterval = null;
                }
            }

            handleTimeOut() {
                const q = questionBank[this.currentQuestionIndex];
                this.sound.playIncorrect();
                this.combo = 0;
                this.updateComboUI();
                this.answeredQuestionsLog.push({
                    question: q.question,
                    userAnswer: '[หมดเวลาตอบ]',
                    correctAnswer: q.correct,
                    isCorrect: false,
                    explanation: q.explanation
                });
                this.nextQuestionDelay();
            }

            handleAnswer(selected, correct, btnElement) {
                this.stopTimer();
                const isCorrect = (selected === correct);
                const buttons = document.querySelectorAll('#options-container button');
                buttons.forEach(b => b.disabled = true);

                if (isCorrect) {
                    this.sound.playCorrect();
                    btnElement.className = 'w-full text-left p-4 rounded-2xl bg-emerald-100 border border-emerald-500 text-emerald-900 font-medium text-sm flex items-center justify-between shadow-md';
                    btnElement.innerHTML += '<i class="fa-solid fa-circle-check text-emerald-600 text-base"></i>';
                    
                    this.correctCount++;
                    this.combo++;
                    if (this.combo > this.maxCombo) this.maxCombo = this.combo;

                    const pts = 100 + (this.timer * 5) + (this.combo > 1 ? (this.combo * 20) : 0);
                    this.score += pts;
                } else {
                    this.sound.playIncorrect();
                    btnElement.className = 'w-full text-left p-4 rounded-2xl bg-rose-100 border border-rose-500 text-rose-900 font-medium text-sm flex items-center justify-between shadow-md';
                    btnElement.innerHTML += '<i class="fa-solid fa-circle-xmark text-rose-600 text-base"></i>';

                    // highlight correct
                    buttons.forEach(b => {
                        if (b.textContent.includes(correct)) {
                            b.className = 'w-full text-left p-4 rounded-2xl bg-emerald-50 border border-emerald-400 text-emerald-800 font-medium text-sm flex items-center justify-between';
                        }
                    });

                    this.combo = 0;
                }

                document.getElementById('current-score').textContent = this.score;
                this.updateComboUI();

                // update player score in multi
                if (this.mode === 'multi') {
                    const me = this.players.find(p => p.name === this.nickname);
                    if (me) me.score = this.score;
                    this.updateLiveScoreboard();
                }

                const q = questionBank[this.currentQuestionIndex];
                this.answeredQuestionsLog.push({
                    question: q.question,
                    userAnswer: selected,
                    correctAnswer: correct,
                    isCorrect: isCorrect,
                    explanation: q.explanation
                });

                this.nextQuestionDelay();
            }

            updateComboUI() {
                const badge = document.getElementById('combo-display');
                if (this.combo > 1) {
                    badge.textContent = `Combo x${this.combo}`;
                    badge.classList.remove('hidden');
                } else {
                    badge.classList.add('hidden');
                }
            }

            nextQuestionDelay() {
                setTimeout(() => {
                    this.currentQuestionIndex++;
                    this.loadQuestion();
                }, 1400);
            }

            endGame() {
                this.stopTimer();
                this.switchView('view-result');
                document.getElementById('final-score').textContent = this.score;
                document.getElementById('final-correct').textContent = `${this.correctCount}/10`;
                document.getElementById('final-combo').textContent = `x${this.maxCombo}`;

                const titleEl = document.getElementById('result-title');
                const subEl = document.getElementById('result-subtitle');
                const trophyEl = document.getElementById('result-trophy');

                if (this.correctCount >= 8) {
                    titleEl.textContent = 'ยอดเยี่ยมระดับผู้เชี่ยวชาญ!';
                    subEl.textContent = 'คุณมีความเข้าใจในยาสมุนไพรในบัญชียาหลักแห่งชาติเป็นอย่างดีเยี่ยม';
                    trophyEl.innerHTML = '<i class="fa-solid fa-trophy"></i>';
                } else if (this.correctCount >= 5) {
                    titleEl.textContent = 'ทำได้ดีมาก!';
                    subEl.textContent = 'คุณมีความรู้พื้นฐานด้านยาสมุนไพรไทยที่ดี สามารถทบทวนเพิ่มเติมได้จากหน้าเฉลย';
                    trophyEl.innerHTML = '<i class="fa-solid fa-medal"></i>';
                } else {
                    titleEl.textContent = 'พยายามอีกนิดนะ!';
                    subEl.textContent = 'ลองอ่านคู่มือและทบทวนสรรพคุณยาสมุนไพรไทยใหม่อีกรอบเพื่อความแม่นยำ';
                    trophyEl.innerHTML = '<i class="fa-solid fa-book-open-reader"></i>';
                }
            }

            openInfoModal() {
                this.sound.playClick();
                const container = document.getElementById('info-groups-list');
                container.innerHTML = questionBank.map(item => `
                    <div class="p-3 rounded-2xl bg-slate-50 border border-slate-200 space-y-1">
                        <div class="font-bold text-clinical-700 text-xs md:text-sm">${item.group}</div>
                        <div class="text-slate-800 font-semibold text-xs"><i class="fa-solid fa-prescription-bottle-medical text-tealmet-600 mr-1.5"></i>สมุนไพรหลัก: ${item.correct}</div>
                        <div class="text-slate-600 text-xs leading-relaxed">${item.explanation}</div>
                    </div>
                `).join('');
                this.openModal('modal-info');
            }

            showReviewModal() {
                this.sound.playClick();
                const container = document.getElementById('review-items-container');
                container.innerHTML = this.answeredQuestionsLog.map((log, idx) => `
                    <div class="p-4 rounded-2xl bg-slate-50 border ${log.isCorrect ? 'border-emerald-200 bg-emerald-50/30' : 'border-rose-200 bg-rose-50/30'} space-y-2">
                        <div class="flex items-center justify-between text-xs font-bold">
                            <span class="text-slate-700">ข้อที่ ${idx+1}</span>
                            <span class="${log.isCorrect ? 'text-emerald-600' : 'text-rose-600'} flex items-center space-x-1">
                                <i class="fa-solid ${log.isCorrect ? 'fa-circle-check' : 'fa-circle-xmark'}"></i>
                                <span>${log.isCorrect ? 'ตอบถูก' : 'ตอบผิด'}</span>
                            </span>
                        </div>
                        <p class="text-slate-800 font-medium text-xs">${log.question}</p>
                        <div class="text-xs space-y-0.5">
                            <div class="text-slate-600">คำตอบของคุณ: <span class="font-semibold ${log.isCorrect ? 'text-emerald-700' : 'text-rose-700'}">${log.userAnswer}</span></div>
                            <div class="text-slate-600">คำตอบที่ถูกต้อง: <span class="font-semibold text-emerald-700">${log.correctAnswer}</span></div>
                        </div>
                        <div class="text-xs text-slate-500 bg-white p-2 rounded-xl border border-slate-200 mt-1">
                            <strong>คำอธิบาย:</strong> ${log.explanation}
                        </div>
                    </div>
                `).join('');
                this.openModal('modal-review');
            }
        }

        const app = new HerbalQuizApp();
    </script>
</body>
</html>